{
  "name": "highlight-companion",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "node --import tsx --test tests/*.test.ts",
    "release:check": "npm test && npm run build && node scripts/check-release.mjs"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "1.13.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0"
  },
  "license": "MIT"
}
